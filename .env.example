# Runtime
APP_ENV=development                 # Required: development, test, or production
APP_VERSION=dev                     # Required: release or commit identifier
DATABASE_URL=postgresql://foody:change-me@postgres:5432/foody  # Required; dedicated DB/user
LOG_LEVEL=INFO                      # Optional: DEBUG, INFO, WARNING, ERROR
PORT=8080                           # Optional: health HTTP server port
DEFAULT_TIMEZONE=Asia/Tehran        # Optional: IANA timezone
APP_ENCRYPTION_KEY=                 # Reserved for future encrypted app secrets; random secret

# Telegram (all required except proxy)
TG_API_ID=                          # Required: numeric API ID from my.telegram.org
TG_API_HASH=                        # Required secret: API hash
TG_STRING_SESSION=                  # Required secret: newly created Telethon StringSession
CONTROL_BOT_TOKEN=                  # Required secret: newly created BotFather token
CONTROL_ADMIN_ID=                   # Required: numeric Telegram ID of the owner
TARGET_CHAT_ID=                     # Required: numeric source group/channel ID
TG_PROXY_URL=                       # Optional secret: http:// or socks5:// proxy URL

# Product behavior
MIN_SEND_INTERVAL_SECONDS=1.0       # Optional: global minimum gap between outbound messages
DEFAULT_USER_COOLDOWN_SECONDS=900   # Optional: per-profile/per-recipient cooldown
JOB_POLL_INTERVAL_SECONDS=1.0       # Optional: durable outbound queue poll interval
POLLER_LOCK_WAIT_SECONDS=120        # Optional: wait for the previous deploy's polling lock
